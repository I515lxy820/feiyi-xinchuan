# 默认是明确标注的本地演示模式。真实使用时改为 openai 和 bocha。
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=

SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search

APP_DB_PATH=data/app.db
PROMPT_VERSION=v1
MODEL_TIMEOUT_SECONDS=45
SEARCH_TIMEOUT_SECONDS=6
CONFIDENCE_THRESHOLD=0.72

# 只读取公开 HTML/XHTML 页面，演示模式下始终禁用真实网页访问。
WEB_READER_ENABLED=true
WEB_TIMEOUT_SECONDS=8
WEB_MAX_PAGES=2
WEB_MAX_BYTES=1048576
